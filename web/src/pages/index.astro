---
import Layout from '../layouts/Layout.astro';
import { getNav, plainTitle } from '../lib/nav';
import { iconFor, folderIcon } from '../lib/icons';

const { modules } = await getNav();
const total = modules.reduce((n, m) => n + m.sections.reduce((k, s) => k + s.pages.length, 0), 0);
const chart = modules.flatMap((m) => m.sections.map((s) => ({ label: s.dir.replace(/^\d+-/, '').slice(0, 24), value: s.pages.length })));
---

<Layout title="Home">
  <div class="home">
    <h1>Web Security &amp; Full-Stack Handbook</h1>
    <p class="lead">{total} lessons on web security, JavaScript, backend, databases, cloud and interview preparation — in plain English.</p>
    <a class="btn primary" href={modules[0]?.url ?? '#'}>Start learning</a>
    <a class="btn ghost" href="#topics">Browse topics</a>

    <div id="topics">
    {modules.map((m) => (
      <>
        <h2>{m.url ? <a href={m.url} style="color:inherit">{m.title}</a> : m.title}</h2>
        {m.blurb && <p class="sub">{m.blurb}</p>}
        <div class="cards">
          {m.sections.map((s) => (
            <a class="card" href={s.url ?? s.pages[0]?.url}>
              <div class="ico"><Fragment set:html={iconFor(s.dir + ' ' + s.title, 'folder')} /></div>
              <div>
                <h3>{plainTitle(s.title)}</h3>
                <p>{s.pages.slice(0, 3).map((p) => plainTitle(p.title)).join(' · ')}</p>
                <div class="count">{s.dir}/ · {s.pages.length} file{s.pages.length === 1 ? '' : 's'}</div>
              </div>
            </a>
          ))}
        </div>
      </>
    ))}
    </div>

    <h2>Content overview</h2>
    <p class="sub">Files per topic folder. Updates automatically as you add content.</p>
    <div class="chart-box"><canvas id="chart" data-chart={JSON.stringify(chart)}></canvas></div>
  </div>
</Layout>

<script>
  const c = document.getElementById('chart') as HTMLCanvasElement;
  const data: { label: string; value: number }[] = JSON.parse(c.dataset.chart!);
  function draw() {
    const dpr = devicePixelRatio || 1, w = c.offsetWidth, h = c.offsetHeight;
    c.width = w * dpr; c.height = h * dpr;
    const g = c.getContext('2d')!; g.scale(dpr, dpr); g.clearRect(0, 0, w, h);
    const css = getComputedStyle(document.documentElement);
    const muted = css.getPropertyValue('--muted').trim(), accent = css.getPropertyValue('--accent').trim();
    const max = Math.max(...data.map((d) => d.value), 1);
    const bottom = 100, top = 20, bw = w / data.length;
    data.forEach((d, i) => {
      const bh = ((h - bottom - top) * d.value) / max, x = i * bw + bw * .2, y = h - bottom - bh, ww = bw * .6;
      g.fillStyle = accent; g.globalAlpha = .85; g.beginPath(); g.roundRect(x, y, ww, bh, 4); g.fill(); g.globalAlpha = 1;
      g.fillStyle = muted; g.font = '600 12px system-ui'; g.textAlign = 'center'; g.fillText(String(d.value), x + ww / 2, y - 6);
      g.save(); g.translate(x + ww / 2, h - bottom + 12); g.rotate(Math.PI / 4); g.textAlign = 'left'; g.font = '11px system-ui'; g.fillText(d.label, 0, 0); g.restore();
    });
  }
  draw(); addEventListener('resize', draw);
  new MutationObserver(draw).observe(document.documentElement, { attributes: true });
</script>
