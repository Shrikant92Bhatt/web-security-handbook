---
import '../styles/global.css';
import { getNav } from '../lib/nav';
import { iconFor } from '../lib/icons';

interface Props {
  title: string;
  headings?: { depth: number; slug: string; text: string }[];
  currentId?: string;
}
const { title, headings = [], currentId } = Astro.props;
const { modules } = await getNav();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Web Security & Full-Stack Engineering Interview Handbook — clear, practical lessons and architecture diagrams." />
    <title>{title} · Web Security Handbook</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline>
      const t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body data-base={base}>
    <div id="progress"></div>
    <header class="header">
      <button class="icon-btn menu-btn" id="menu-btn" aria-label="Menu">☰</button>
      <a class="brand" href={`${base}/`}>
        <span class="brand-mark"><Fragment set:html={iconFor('shield-check')} /></span>
        <span>Security &amp; Full-Stack Handbook</span>
      </a>
      <nav class="nav-links">
        {modules.map((m) => (
          <a href={m.url ?? `${base}/`}>
            {m.id === 'extras'
              ? 'Resources'
              : m.id.match(/^Module-(\d+)/)
                ? `Module ${m.id.match(/^Module-(\d+)/)![1]}`
                : m.shortTitle}
          </a>
        ))}
      </nav>
      <div class="spacer"></div>
      <button class="search-btn" id="search-open" aria-label="Search handbook">
        <Fragment set:html={iconFor('search', 'file-text')} />
        <span>Search lessons…</span>
        <kbd>Ctrl K</kbd>
      </button>
      <button class="icon-btn" id="theme-btn" aria-label="Toggle color theme" title="Toggle light/dark mode">◐</button>
    </header>

    <div class:list={['shell', { 'no-toc': toc.length === 0 }]}>
      <aside class="sidebar" id="sidebar">
        {modules.map((m) => (
          <div class="mod-group">
            <div class="mod-title">
              <a href={m.url ?? `${base}/`}>{m.shortTitle}</a>
            </div>
            {m.sections.map((s) => {
              const isOpen = s.pages.some((p) => p.id === currentId) || m.id === currentId;
              return (
                <details class="sec" open={isOpen}>
                  <summary>
                    <span class="sec-ico"><Fragment set:html={iconFor(s.dir + ' ' + s.title, 'folder')} /></span>
                    <span class="sec-label">{s.label}</span>
                    <span class="chev">›</span>
                  </summary>
                  <ul>
                    {s.pages.map((p) => (
                      <li>
                        <a href={p.url} class:list={{ active: p.id === currentId }} title={p.title}>
                          <Fragment set:html={iconFor(p.file + ' ' + p.title)} />
                          <span>{p.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })}
          </div>
        ))}
      </aside>

      <main class="main"><slot /></main>

      {toc.length > 0 && (
        <aside class="toc">
          <h4>On this page</h4>
          {toc.map((h) => (
            <a href={`#${h.slug}`} class={h.depth === 3 ? 'l3' : ''}>
              {h.text.replace(/^[^\p{L}\p{N}]+/u, '')}
            </a>
          ))}
        </aside>
      )}
    </div>

    <footer class="footer">
      Web Security &amp; Full-Stack Engineering Handbook · Add any Markdown file in <code>Module-*/</code> to publish a new lesson.
    </footer>

    <div id="search-modal">
      <div class="search-box">
        <input id="search-input" placeholder="Search XSS, JWT, Redis, CORS, PostgreSQL…" autocomplete="off" />
        <div class="results" id="search-results"></div>
      </div>
    </div>

    <script>
      const base = document.body.dataset.base ?? '';
      const $ = (s: string) => document.querySelector(s) as HTMLElement | null;

      // Theme toggle
      $('#theme-btn')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        renderMermaid();
      });

      // Mobile menu
      $('#menu-btn')?.addEventListener('click', () => $('#sidebar')?.classList.toggle('open'));

      // Reading progress
      const bar = $('#progress')!;
      addEventListener(
        'scroll',
        () => {
          const h = document.documentElement;
          bar.style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight || 1)) * 100 + '%';
        },
        { passive: true }
      );

      // Scroll sidebar to active link
      document.querySelector('.sidebar a.active')?.scrollIntoView({ block: 'center' });

      // Wrap tables, add copy buttons
      document.querySelectorAll('.prose table').forEach((t) => {
        const w = document.createElement('div');
        w.className = 'table-wrap';
        t.replaceWith(w);
        w.appendChild(t);
      });
      document.querySelectorAll('.prose pre.astro-code').forEach((pre) => {
        const b = document.createElement('button');
        b.className = 'copy-btn';
        b.textContent = 'Copy';
        b.onclick = () => {
          navigator.clipboard.writeText(pre.textContent ?? '');
          b.textContent = 'Copied ✓';
          setTimeout(() => (b.textContent = 'Copy'), 1500);
        };
        pre.appendChild(b);
      });

      // TOC scroll-spy
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
      if (links.length) {
        const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
        const io = new IntersectionObserver(
          (es) => {
            es.forEach((e) => {
              if (e.isIntersecting) {
                links.forEach((l) => l.classList.remove('on'));
                map.get(e.target.id)?.classList.add('on');
              }
            });
          },
          { rootMargin: '-80px 0px -70% 0px' }
        );
        map.forEach((_, id) => {
          const el = document.getElementById(id);
          if (el) io.observe(el);
        });
      }

      // Mermaid diagrams with calm teal/slate palette
      const sources = new Map<Element, string>();
      async function renderMermaid() {
        const nodes = [...document.querySelectorAll('pre.mermaid')];
        if (!nodes.length) return;
        const { default: mermaid } = await import('mermaid');
        const dark = document.documentElement.dataset.theme === 'dark';
        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: dark
            ? {
                primaryColor: '#134e4a',
                primaryTextColor: '#f1f5f9',
                primaryBorderColor: '#2dd4bf',
                lineColor: '#94a3b8',
                secondaryColor: '#1e293b',
                tertiaryColor: '#0f172a',
                noteBkgColor: '#1e293b',
                noteTextColor: '#f1f5f9',
                actorBkg: '#134e4a',
                actorTextColor: '#f1f5f9',
                signalColor: '#cbd5e1',
                signalTextColor: '#cbd5e1',
              }
            : {
                primaryColor: '#ccfbf1',
                primaryTextColor: '#0f172a',
                primaryBorderColor: '#0d9488',
                lineColor: '#64748b',
                secondaryColor: '#f1f5f9',
                tertiaryColor: '#ffffff',
                noteBkgColor: '#f0fdfa',
                noteTextColor: '#0f172a',
                actorBkg: '#ccfbf1',
                actorTextColor: '#0f172a',
                signalColor: '#334155',
                signalTextColor: '#0f172a',
              },
        });
        for (const n of nodes) {
          if (!sources.has(n)) sources.set(n, n.textContent ?? '');
          n.removeAttribute('data-processed');
          n.textContent = sources.get(n)!;
        }
        try {
          await mermaid.run({ nodes: nodes as HTMLElement[] });
        } catch (e) {
          console.warn(e);
        }
      }
      renderMermaid();

      // Search
      type Doc = { t: string; u: string; s: string; h: string; x: string };
      let docs: Doc[] | null = null;
      const modal = $('#search-modal')!;
      const input = $('#search-input') as HTMLInputElement;
      const out = $('#search-results')!;
      async function open() {
        modal.classList.add('open');
        input.focus();
        if (!docs) docs = await (await fetch(`${base}/search.json`)).json();
        run();
      }
      const close = () => modal.classList.remove('open');
      function run() {
        const q = input.value.toLowerCase().trim();
        const words = q.split(/\s+/).filter(Boolean);
        const scored = (docs ?? [])
          .map((d) => {
            const title = d.t.toLowerCase(),
              heads = d.h.toLowerCase(),
              text = d.x.toLowerCase();
            let score = 0;
            for (const w of words) {
              if (title.includes(w)) score += 10;
              else if (heads.includes(w)) score += 4;
              else if (text.includes(w)) score += 1;
              else return { d, score: -1 };
            }
            return { d, score };
          })
          .filter((r) => r.score >= 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 12);
        out.innerHTML = scored.length
          ? scored.map(({ d }) => `<a href="${d.u}">${d.t}<small>${d.s}</small></a>`).join('')
          : '<div class="empty">No matching lessons found</div>';
      }
      $('#search-open')?.addEventListener('click', open);
      input.addEventListener('input', run);
      modal.addEventListener('click', (e) => e.target === modal && close());
      addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          open();
        }
        if (e.key === 'Escape') close();
        if (e.key === 'Enter' && modal.classList.contains('open'))
          (out.querySelector('a') as HTMLAnchorElement | null)?.click();
      });
    </script>
  </body>
</html>
